#!/usr/bin/env bash
# Shared configuration for all scripts in this repository.
# Source this file before running any deployment or benchmark script:
#   source config.env

# --- Cluster ---
export CLUSTER_NAME="llm-d-flow-control"
export AWS_REGION="us-east-2"

# --- Namespaces ---
export NAMESPACE="llm-d-poc"
export BATCH_NAMESPACE="batch-api"
export GATEWAY_NAMESPACE="istio-ingress"
export MONITORING_NAMESPACE="llm-d-monitoring"

# --- Model ---
export MODEL_NAME="nvidia/NVIDIA-Nemotron-Nano-9B-v2"
export MODEL_SHORT_NAME="nemotron-nano-9b"
export VLLM_REPLICAS=2

# --- Component versions ---
export GATEWAY_API_VERSION="v1.5.1"
export GAIE_VERSION="v1.5.0"
export ISTIO_VERSION="1.29.2"
export CERT_MANAGER_VERSION="v1.20.3"
export LLMD_VERSION="v0.8.1"
export ROUTER_CHART_VERSION="v0.10.0"
export VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.27.1"
export BATCH_GATEWAY_VERSION="0.5.0"

# --- llm-d Router ---
export POOL_NAME="vllm-${MODEL_SHORT_NAME}"
export EPP_RELEASE="${POOL_NAME}"
export EPP_NAME="${EPP_RELEASE}-epp"

# --- Flow control InferenceObjective names ---
export FC_REALTIME_OBJECTIVE="realtime"
export FC_STANDARD_OBJECTIVE="standard"
export FC_BATCH_OBJECTIVE="low-priority"

# --- Gateway ---
export GATEWAY_NAME="llm-d-inference-gateway"

# --- Batch Gateway ---
export BATCH_INTERNAL_GATEWAY_NAME="batch-internal-gateway"

# --- Observability ---
export PROMETHEUS_PORT=9090
export GRAFANA_PORT=3000
export GRAFANA_ADMIN_PASSWORD="admin"

# --- Benchmarks ---
export BENCHMARK_DURATION="120"  # seconds per aiperf run
export BENCHMARK_OUTPUT_DIR="benchmarks/results"

# --- Derived (do not edit) ---
export GATEWAY_IP=""  # populated at runtime by scripts
