{
  "uid": "fairness-analysis",
  "title": "Fairness Analysis",
  "tags": [
    "llm-d",
    "fairness"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "panels": [
    {
      "id": 7,
      "title": "Request Count by Tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{fairness_id!=\"default-flow\"}[15s]))",
          "legendFormat": "{{fairness_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jain's Fairness Index",
      "description": "Measures how fairly capacity is distributed across tenants. 1.0 = perfectly fair.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))) ^ 2 / (count(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))) * sum(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s])) ^ 2))",
          "legendFormat": "fairness index"
        }
      ]
    },
    {
      "id": 3,
      "title": "Avg Wait Time by Tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_sum{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s])) / sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))",
          "legendFormat": "{{fairness_id}}"
        }
      ]
    },
    {
      "id": 1,
      "title": "Dispatch Count by Tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))",
          "legendFormat": "{{fairness_id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Queue Depth by Tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(fairness_id) (llm_d_epp_flow_control_queue_size{fairness_id!=\"default-flow\"})",
          "legendFormat": "{{fairness_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Current Fairness Index",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))) ^ 2 / (count(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s]))) * sum(sum by(fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_count{outcome=\"Dispatched\", fairness_id!=\"default-flow\"}[15s])) ^ 2))",
          "legendFormat": "fairness index"
        }
      ]
    }
  ]
}
