{
  "uid": "latency-by-tier",
  "title": "Latency by Tier",
  "tags": [
    "llm-d",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "TTFT p50 by Tier",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "premium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "standard"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "low-priority"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(label_replace(histogram_quantile(0.50, sum by(le, priority) (rate(llm_d_epp_request_ttft_seconds_bucket[15s]))), \"tier\", \"premium\", \"priority\", \"100\"), \"tier\", \"standard\", \"priority\", \"0\"), \"tier\", \"low-priority\", \"priority\", \"-1\")",
          "legendFormat": "{{tier}}"
        }
      ]
    },
